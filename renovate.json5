{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:monorepos",
    "group:recommended",
    ":automergeMinor",
    ":automergePatch"
  ],
  "labels": ["dependencies"],
  "rebaseWhen": "conflicted",
  "pre-commit": { "enabled": true },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates for stable dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Do not automerge major updates or pre-1.0 dependencies",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true
    },
    {
      "description": "ruff is pinned twice, in pyproject.toml and as the ruff-pre-commit hook, and scripts/check_ruff_version_sync.py fails when they differ, so both move in one pull request",
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "groupName": "ruff"
    },
    {
      "description": "The pre-commit manager is on for ruff's hook only; every other hook keeps its pinned rev",
      "matchManagers": ["pre-commit"],
      "matchPackageNames": ["!astral-sh/ruff-pre-commit"],
      "enabled": false
    },
    {
      "description": "The interpreter version is set in several files that scripts/check_python_version_sync.py keeps equal, so a .python-version bump alone always fails; moving it is a deliberate change",
      "matchManagers": ["pyenv"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  }
}
