zz:DV-1","fingerprint":"22da09a2415b0afa71404abdea42a5aae80d709e0e1e401bd829f60df5632961","id":"DV-1","member_digest":"blob:c454026f066f10c7e3b3537c2acd9ab8bab44861","reachable_behavior":"The broadened suite has no mutation test for replacement after dead-pane observation and mocks the sandbox ownership boundary.","severity":"major","submitted_severity":"major"},{"cluster":{"invariant_id":"implicit-lifecycle-no-cross-session-signal","spec_version":null,"subsystem":"bg-spare-cleanup","violation_kind":"name-classifier-false-negative"},"disposition":"fixed","finding_key":"ai-cli-1wzz:F-1","fingerprint":"4be0d3bf3751c5baea422e9ae793f4c04de025e162a64b474dcf02bf0f5a4e1a","id":"F-1","member_digest":"blob:c454026f066f10c7e3b3537c2acd9ab8bab44861","reachable_behavior":"Implicit launch cleanup no longer signals background helper processes and only removes stale state records.","severity":"major","submitted_severity":"major"},{"cluster":{"invariant_id":"owned-session-destruction-only","spec_version":null,"subsystem":"quota-scrape","violation_kind":"fixed-name-unowned-kill"},"disposition":"fixed","finding_key":"ai-cli-1wzz:F-2","fingerprint":"e71908a3ae85d879b93a459d732ace20ff1594b2646ae68545c5bc7cd7a6cda1","id":"F-2","member_digest":"blob:c454026f066f10c7e3b3537c2acd9ab8bab44861","reachable_behavior":"Quota scraping uses a unique name and cleanup can kill only the captured opaque ID with its expected random generation.","severity":"major","submitted_severity":"major"},{"cluster":{"invariant_id":"owned-session-destruction-only","spec_version":null,"subsystem":"session-launch","violation_kind":"name-only-destruction"},"disposition":"fixed","finding_key":"ai-cli-1wzz:F-3","fingerprint":"ad63c84311244b496f9fa242bc302eb887f45fc60c372db0447d0a73559fcf77","id":"F-3","member_digest":"blob:c454026f066f10c7e3b3537c2acd9ab8bab44861","reachable_behavior":"Explicit sandbox replacement refuses tokenless sessions and requires an atomic ID and generation match before killing.","severity":"maj